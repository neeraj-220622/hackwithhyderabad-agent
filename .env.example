# Environment variables template — copy to .env and fill in values.
# NEVER commit .env to source control.

# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key-here

# ── Hindsight memory service ─────────────────────────────────────────────────
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
